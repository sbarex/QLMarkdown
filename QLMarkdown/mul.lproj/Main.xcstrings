    "tkA-dO-Pi7.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If enabled, all softbreak elements (newlines inside paragraphs in the Markdown source) should be rendered as spaces.  Has no effect on HTML formatting.\"; ObjectID = \"tkA-dO-Pi7\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, all softbreak elements (newlines inside paragraphs in the Markdown source) should be rendered as spaces.  Has no effect on HTML formatting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abilitato, tutti gli elementi “softbreak” (interruzioni di riga all’interno dei paragrafi nel codice sorgente Markdown) dovrebbero essere visualizzati come spazi. Ininfluente nella formattazione HTML."
          }
        }
      }
    },
